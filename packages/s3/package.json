{
  "name": "@mythrart/s3",
  "version": "1.0.0",
  "description": "Shared S3 dependencies between Mythrart apps",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup index.ts --format esm --dts --clean --shims",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/lib-storage": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@mythrart/database": "workspace:*",
    "@mythrart/env": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
