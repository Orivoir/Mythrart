model SceneEntity {
  sceneId  String
  scene    Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  entityId String
  entity   EbookEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([sceneId, entityId])
  @@index([entityId])
}