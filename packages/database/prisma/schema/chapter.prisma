model Chapter {
  id        String   @id @default(cuid())
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ebookId String
  ebook   Ebook  @relation(fields: [ebookId], references: [id])

  assetReferences      ChapterAssetReference[]
  collaboratorAccess   EbookCollaboratorChapterAccess[]
  explorerPublications ExplorerPublicationChapter[]

  wordsCount      Int @default(0)
  charactersCount Int @default(0)

  scenes Scene[]

  entityRelationStates EbookEntityRelationState[] @relation("RelationStateChapter")

  locales ChapterLocale[]

  @@unique([ebookId, position])
  @@index([ebookId])
}
