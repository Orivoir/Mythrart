model ExplorerPublication {
  id String @id @default(cuid())

  ebookId String
  ebook   Ebook  @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  snapshotId String
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  reason ExplorerPublicationReason

  title        String?
  description  String?
  objective    String?
  synopsis     String?
  targetLocale String?

  allowRatings  Boolean @default(true)
  allowComments Boolean @default(true)

  status ExplorerPublicationStatus @default(DRAFT)

  viewsCount Int @default(0)

  chapters ExplorerPublicationChapter[]
  comments ExplorerPublicationComment[]
  ratings  ExplorerPublicationRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ebookId])
  @@index([snapshotId])
  @@index([reason])
  @@index([status])
}
