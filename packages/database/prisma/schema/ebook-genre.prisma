model EbookGenre {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?

  ebooks EbookGenreAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EbookGenreAssignment {
  ebookId String
  ebook   Ebook  @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  genreId String
  genre   EbookGenre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([ebookId, genreId])
  @@index([genreId])
}
