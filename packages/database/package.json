{
  "name": "@mythrart/database",
  "version": "1.0.0",
  "description": "Shared database dependencies between Mythrart apps",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json && rm -rf dist/app && mkdir -p dist/app && cp -r app/generated dist/app/generated",
    "clean": "rm -rf dist",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate": "pnpm exec prisma migrate deploy",
    "prisma:migrate:test": "DATABASE_URL=\"postgresql://mythrart:mythrart@localhost:5432/e2e_test\" pnpm exec prisma migrate deploy",
    "prisma:migrate:all": "pnpm run prisma:migrate && pnpm run prisma:migrate:test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mythrart/env": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prisma": "7.8.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ]
}
